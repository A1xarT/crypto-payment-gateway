# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crypto_gateway

# ── Security ──────────────────────────────────────────────────────────────────
# JWT signing secret — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change_me_to_a_random_secret
JWT_EXPIRES_IN=7d

# AES-256-CBC key used to encrypt private keys at rest.
# Must be exactly 32 bytes (64 hex characters). REQUIRED in production.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Ethereum ──────────────────────────────────────────────────────────────────
# Mainnet JSON-RPC endpoint (Alchemy, Infura, or your own node)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Sepolia testnet endpoint (required for TESTNET payments / sk_test_ keys)
TESTNET_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Payments ──────────────────────────────────────────────────────────────────
# How many minutes a PENDING payment remains valid before expiring
PAYMENT_EXPIRY_MINUTES=30

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Email (optional) ──────────────────────────────────────────────────────────
# Leave unset to disable email notifications entirely.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Crypto Gateway <notifications@example.com>"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave unset to allow all (dev only).
# CORS_ORIGINS=https://myshop.com,https://app.myshop.com

# ── Observability ─────────────────────────────────────────────────────────────
# Protects GET /metrics — leave unset to allow unauthenticated scraping
# (only safe if /metrics is firewalled / not exposed publicly)
# METRICS_TOKEN=your-prometheus-scrape-token

# ── Deployment ────────────────────────────────────────────────────────────────
# Public base URL — used in checkout session URLs returned to clients
BASE_URL=https://api.yourdomain.com

# Your domain — used by nginx in docker-compose.prod.yml
DOMAIN=api.yourdomain.com

# ── Docker Compose only ───────────────────────────────────────────────────────
# Password for the bundled PostgreSQL container
POSTGRES_PASSWORD=postgres
